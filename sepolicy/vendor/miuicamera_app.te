# MIUI Camera (com.android.camera): platform key, priv-app, targetSdk 31.
# Same base as platform_app_36 (app, net, bluetooth, platform_app_all).
type miuicamera_app, domain;
typeattribute miuicamera_app coredomain;
app_domain(miuicamera_app)
net_domain(miuicamera_app)
bluetooth_domain(miuicamera_app)
platform_app_domain(miuicamera_app)

# MiAlgoEngine/libapusys (portrait, night) aborts when /dev/apusys cannot be opened
allow miuicamera_app apusys_device:chr_file { open read write ioctl getattr map };
typeattribute apusys_device mlstrustedobject;

# isphal IISPModule for raw reprocess (night, macro)
hal_client_domain(miuicamera_app, hal_mtk_bgs)
binder_call(miuicamera_app, mtk_hal_camera)

# Add-on features ship as qigsaw split .so files under the app's data dir
allow miuicamera_app app_data_file:file execute;

# Optional probes on stock-only services and debug props
dontaudit miuicamera_app default_android_hwservice:hwservice_manager find;
dontaudit miuicamera_app vendor_default_prop:file { read open getattr map };
dontaudit miuicamera_app proc_stat:file { read open getattr };
