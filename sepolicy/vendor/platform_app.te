# MIUI Camera runs as platform_app(_36) (platform key, targetSdk 31).

# MiAlgoEngine/libapusys (portrait, night) aborts when /dev/apusys cannot be opened
allow { platform_app platform_app_36 } apusys_device:chr_file { open read write ioctl getattr map };
typeattribute apusys_device mlstrustedobject;

# isphal IISPModule for raw reprocess
hal_client_domain(platform_app, hal_mtk_bgs)
hal_client_domain(platform_app_36, hal_mtk_bgs)
binder_call(platform_app, mtk_hal_camera)
binder_call(platform_app_36, mtk_hal_camera)

# Add-on features ship as qigsaw split .so files under the app's data dir
allow { platform_app platform_app_36 } app_data_file:file execute;

# Optional probes on stock-only services and debug props
dontaudit { platform_app platform_app_36 } default_android_hwservice:hwservice_manager find;
dontaudit { platform_app platform_app_36 } vendor_default_prop:file { read open getattr map };
dontaudit { platform_app platform_app_36 } proc_stat:file { read open getattr };
